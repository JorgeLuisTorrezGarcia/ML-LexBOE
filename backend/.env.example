# Copia este archivo como .env y ajusta los valores si es necesario.
# En Docker estas variables ya vienen definidas en el Dockerfile.

# Ruta al modelo (relativa a la carpeta backend/ o absoluta)
MODEL_PATH=modelo_lexboe.joblib
INFO_PATH=modelo_lexboe_info.json

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Ruta al frontend compilado (solo si existe; en dev con Vite no aplica)
# FRONTEND_DIST=../frontend/dist
